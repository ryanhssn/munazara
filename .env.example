# ─── API keys (required) ───────────────────────────────────────────────
# Bring your own. Debaters + judge are drawn from these three vendors.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# ─── Evidence retrieval / RAG (optional) ───────────────────────────────
# Set to use Tavily for the RAG toggle; falls back to DuckDuckGo if unset.
TAVILY_API_KEY=tvly-...

# ─── Backend config (optional) ─────────────────────────────────────────
# Allowed CORS origin — override for production.
CORS_ORIGIN=http://localhost:3000
# SQLite path for debate checkpoints.
DEBATE_DB_PATH=debate.sqlite
# Per-LLM-call timeout in seconds.
LLM_CALL_TIMEOUT_SECS=120
LOG_LEVEL=INFO

# ─── Frontend → backend URL ────────────────────────────────────────────
# Read by the Next.js app. In docker compose this points at the backend service.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── LangSmith tracing (optional) ──────────────────────────────────────
# Get a key at smith.langchain.com.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=munazara
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
